---
export const prerender = false;

import EventReel from '../components/EventReel.astro';
import Layout from '../layouts/Layout.astro';
import { getPublishedEvents } from '../lib/events';
import { filtersFromURL, matchesEvent } from '../lib/filters';
import { districtLabels } from '../lib/labels';

const filters = filtersFromURL(Astro.url);
const feed = await getPublishedEvents();
const slides = feed.events
  .filter((event) => matchesEvent(event, filters))
  .sort((a, b) => new Date(a.startDate).getTime() - new Date(b.startDate).getTime())
  .map((event) => ({
    name: event.title,
    place: event.locationName || districtLabels[event.district],
    year: new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Nicosia', year: 'numeric' }).format(new Date(event.startDate)),
    image: event.imageUrl,
    href: `/events/${event.slug}`,
  }));

const description = 'Οι προσεχείς εκδηλώσεις στην Κύπρο.';
---

<Layout title="Εκδηλώσεις" description={description} bare locked>
  <EventReel slides={slides} showBack />
</Layout>
