---
export const prerender = false;

import ChevronLeft from '@lucide/astro/icons/chevron-left';
import ChevronRight from '@lucide/astro/icons/chevron-right';
import Search from '@lucide/astro/icons/search';
import EventCard from '../components/EventCard.astro';
import FilterDock from '../components/FilterDock.astro';
import Layout from '../layouts/Layout.astro';
import { getPublishedEvents } from '../lib/events';
import { filtersFromURL, isBoosted, isUpcoming, matchesEvent } from '../lib/filters';
import { formatMonthYear } from '../lib/format';
import { resultLabel } from '../lib/labels';

const feed = await getPublishedEvents();
const events = feed.events.filter((event) => isUpcoming(event));
const filters = filtersFromURL(Astro.url);
const visible = events.filter((event) => matchesEvent(event, filters));
const featured = events.filter((event) => isBoosted(event));
const visibleFeatured = featured.filter((event) => matchesEvent(event, filters));
const origin = Astro.url.origin;

Astro.response.headers.set('Cache-Control', 'public, max-age=60, stale-while-revalidate=300');

const description = 'Ανακάλυψε τι γίνεται στην Κύπρο: πανηγύρια, συναυλίες, οικογενειακές βόλτες και γεύσεις, σήμερα και κοντά σου.';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: "What's On Cyprus",
  itemListElement: visible.map((event, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: event.title,
    url: new URL(`/events/${event.slug}`, origin).href,
  })),
};
---

<Layout title="Ανακάλυψε τι γίνεται στην Κύπρο · What's On Cyprus" description={description} jsonLd={jsonLd}>
  <div class="mx-auto max-w-6xl px-4 pt-5 sm:px-6 md:pt-8">
    <section class="relative overflow-hidden rounded-[28px] bg-ink px-5 py-7 text-white sm:px-8 sm:py-9">
      <div class="pointer-events-none absolute -right-16 -top-20 h-56 w-56 rounded-full bg-sun/30 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-16 -left-10 h-44 w-44 rounded-full bg-sea/50 blur-3xl"></div>
      <div class="relative max-w-2xl">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-sun">{formatMonthYear()}</p>
        <h1 class="mt-2 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">Ανακάλυψε τι γίνεται στην Κύπρο</h1>
        <p class="mt-3 max-w-xl text-base text-white/75 sm:text-lg">
          Πανηγύρια, συναυλίες, οικογενειακές βόλτες και γεύσεις — φιλτραρισμένα για σήμερα, κοντά σου.
        </p>
        <form data-search-form action="/" method="get" role="search" class="mt-6">
          {filters.timeframe && <input type="hidden" name="when" value={filters.timeframe} />}
          {filters.district !== 'all' && <input type="hidden" name="district" value={filters.district} />}
          {filters.category && <input type="hidden" name="category" value={filters.category} />}
          <label class="flex items-center gap-2 rounded-full bg-white p-1.5 pl-4 text-ink shadow-lg">
            <span class="sr-only">Αναζήτηση εκδήλωσης</span>
            <Search size={18} class="shrink-0 text-muted" aria-hidden="true" />
            <input
              id="q"
              data-search-input
              type="search"
              name="q"
              value={filters.q}
              placeholder="Χωριό ή εκδήλωση…"
              class="w-full bg-transparent py-2 text-base outline-none placeholder:text-muted"
            />
            <button
              type="submit"
              class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-coral text-sm font-semibold text-white sm:h-auto sm:w-auto sm:px-4 sm:py-2.5"
              aria-label="Αναζήτηση"
            >
              <Search size={18} class="sm:hidden" aria-hidden="true" />
              <span class="hidden sm:inline">Αναζήτηση</span>
            </button>
          </label>
        </form>
      </div>
    </section>

    {
      feed.source === 'mock' && (
        <p class="mt-4 rounded-2xl border border-sun/40 bg-sun/15 px-4 py-3 text-sm text-ink">
          {feed.reason === 'error'
            ? 'Το Sanity δεν απάντησε. Προβάλλουμε δείγμα εκδηλώσεων για να μείνει ανοιχτή η προεπισκόπηση.'
            : 'Προεπισκόπηση με δείγμα εκδηλώσεων. Σύνδεσε το Sanity για να εμφανιστούν οι πραγματικές καταχωρήσεις.'}
        </p>
      )
    }
  </div>

  <FilterDock filters={filters} />

  <div class="mx-auto max-w-6xl px-4 pb-28 sm:px-6 md:pb-16">
    <section id="featured-section" class="mt-8" hidden={visibleFeatured.length === 0}>
      <div class="mb-4 flex items-end justify-between gap-3">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-sea">Sponsored</p>
          <h2 class="text-2xl font-semibold tracking-tight">Προτεινόμενα</h2>
        </div>
        <div class="hidden gap-2 sm:flex">
          <button id="featured-prev" type="button" class="grid h-10 w-10 place-items-center rounded-full border border-line bg-paper" aria-label="Προηγούμενα">
            <ChevronLeft size={18} aria-hidden="true" />
          </button>
          <button id="featured-next" type="button" class="grid h-10 w-10 place-items-center rounded-full border border-line bg-paper" aria-label="Επόμενα">
            <ChevronRight size={18} aria-hidden="true" />
          </button>
        </div>
      </div>
      <div id="featured-scroller" class="flex snap-x gap-4 overflow-x-auto no-scrollbar pb-2">
        {featured.map((event, index) => (
          <EventCard event={event} featured priority={index === 0} hidden={!matchesEvent(event, filters)} />
        ))}
      </div>
    </section>

    <section class="mt-10">
      <div class="mb-4 flex items-end justify-between gap-3">
        <h2 class="text-2xl font-semibold tracking-tight">Όλες οι εκδηλώσεις</h2>
        <p id="result-count" class="text-sm font-medium text-muted">{resultLabel(visible.length)}</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {events.map((event) => (
          <EventCard event={event} hidden={!matchesEvent(event, filters)} />
        ))}
      </div>
      <div id="feed-empty" class="mt-6 rounded-[28px] border border-dashed border-line bg-paper px-6 py-12 text-center" hidden={visible.length > 0}>
        <p class="text-lg font-semibold">Δεν βρήκαμε εκδηλώσεις</p>
        <p class="mx-auto mt-2 max-w-md text-sm text-muted">Δοκίμασε άλλη ημερομηνία, επαρχία ή λέξη. Οι περασμένες εκδηλώσεις δεν εμφανίζονται στη λίστα.</p>
      </div>
    </section>
  </div>
</Layout>

<script>
  import { initFilters } from '../scripts/apply-filters';
  initFilters();
</script>
