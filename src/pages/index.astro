---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Overture from '../components/Overture';

const description = 'Κατηγορίες στην Κύπρο: εκδηλώσεις, πανηγύρια, μουσική, οικογένεια, γεύσεις, πολιτισμός και εξορμήσεις.';
---

<Layout title="Volta" description={description} bare>
  <Overture client:load skipIntro={Astro.url.searchParams.get('ready') === '1'} />
</Layout>
