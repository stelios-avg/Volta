---
export const prerender = false;

import '@fontsource/archivo/latin-900.css';
import VenueForm from '../../components/VenueForm.astro';
import Layout from '../../layouts/Layout.astro';

const status = Astro.url.searchParams.get('status');
const preview = Astro.url.searchParams.get('preview') === '1';
Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<Layout title="Νέα καταχώριση" description="Βάλε τον χώρο σου με τις δραστηριότητές του στη Volta." robots={status ? 'noindex, nofollow' : undefined} bare>
  <div class="submit-page">
    <a href="/venues" class="submit-back">
      <span aria-hidden="true">←</span>
      Χώροι
    </a>
    <section class="submit-frame">
      <p class="submit-kicker">Χώρος</p>
      <h1>Νέα καταχώριση</h1>
      <p class="submit-lead">Για όσους έχουν έναν χώρο με δραστηριότητες. Δωρεάν καταχώρηση. Δημοσιεύεται μετά την έγκριση.</p>
      {
        status === 'sent' ? (
          <div class="submit-status">
            <h2>Ο χώρος περιμένει έγκριση</h2>
            <p>
              {preview
                ? 'Δοκιμαστική λειτουργία: ο χώρος δεν αποθηκεύτηκε.'
                : 'Τον λάβαμε. Θα εμφανιστεί στη σελίδα Χώροι μόλις εγκριθεί.'}
            </p>
            <a href="/venues">Πίσω στους χώρους</a>
          </div>
        ) : (
          <VenueForm />
        )
      }
    </section>
  </div>
</Layout>

<style is:global>
  .submit-page { min-height: 100dvh; background: #e7e0d1; color: #16120c; padding: 92px 20px 72px; }
  .submit-back {
    position: fixed; z-index: 30; top: 18px; left: 18px; display: inline-flex; align-items: center; gap: 0.45rem;
    border: 1px solid #111; border-radius: 999px; background: #e7e0d1; color: #111; padding: 0.45rem 0.85rem;
    font-size: 12px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; text-decoration: none;
  }
  .submit-frame { max-width: 760px; margin: 0 auto; border: 1px solid #111; border-radius: 36px; padding: 42px 40px 36px; }
  .submit-kicker { margin: 0; color: #6f6d6a; font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; }
  .submit-frame h1 {
    margin: 12px 0 0; font-family: Archivo, Inter, sans-serif; font-size: clamp(42px, 7vw, 72px);
    font-weight: 900; letter-spacing: -0.045em; line-height: 0.88; text-transform: uppercase;
  }
  .submit-lead, .submit-status p { max-width: 36rem; margin: 14px 0 0; color: #3c3832; font-size: 15px; line-height: 1.55; }
  .submit-form { display: grid; gap: 1.15rem; margin-top: 2rem; }
  .submit-page .field span { color: #16120c; font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; }
  .submit-page .field input, .submit-page .field select, .submit-page .field textarea {
    border: 0; border-bottom: 1px solid #16120c; border-radius: 0; background: transparent; padding: 0.65rem 0; color: #16120c; width: 100%;
  }
  .submit-page .field textarea { min-height: 7.5rem; border: 1px solid #16120c; border-radius: 18px; padding: 0.85rem 0.95rem; }
  .submit-page .field { display: flex; flex-direction: column; gap: 0.4rem; }
  .submit-error { margin: 0; color: #9a3412; font-size: 14px; }
  .submit-send, .submit-status a {
    display: inline-flex; width: fit-content; align-items: center; border: 1px solid #111; border-radius: 999px;
    background: #16120c; color: #f3ede1; padding: 0.8rem 1.15rem; font-size: 12px; font-weight: 600;
    letter-spacing: 0.12em; text-transform: uppercase; text-decoration: none;
  }
  .submit-status { margin-top: 1.75rem; }
  .submit-status h2 { margin: 0; font-size: 1.35rem; font-weight: 600; }
  .submit-status a { margin-top: 1.25rem; }
  @media (max-width: 720px) {
    .submit-page { padding: 104px 12px 48px; }
    .submit-frame { border-radius: 22px; padding: 28px 18px 24px; }
    .submit-frame h1 { font-size: clamp(28px, 8.6vw, 40px); }
  }
</style>
