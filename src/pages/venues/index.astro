---
export const prerender = false;

import EventReel from '../../components/EventReel.astro';
import Layout from '../../layouts/Layout.astro';
import { fetchPublishedVenues } from '../../lib/sanity';
import { districtLabels, categoryLabels } from '../../lib/labels';

let venues: Awaited<ReturnType<typeof fetchPublishedVenues>> = [];
try {
  venues = await fetchPublishedVenues();
} catch (error) {
  console.error(error);
}
const slides = venues.map((venue) => ({
  name: venue.title,
  place: venue.locationName || districtLabels[venue.district],
  year: categoryLabels[venue.category],
  image: venue.imageUrl,
  href: `/venues/${venue.slug}`,
}));
---

<Layout title="Χώροι" description="Χώροι με δραστηριότητες στην Κύπρο." bare locked>
  <EventReel
    slides={slides}
    showBack
    emptyText="Δεν υπάρχουν ακόμα χώροι."
    emptyHref="/venues/submit"
    emptyLabel="Καταχώρηση χώρου"
  />
</Layout>
