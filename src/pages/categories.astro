---
export const prerender = false;

import DoorFilters from '../components/DoorFilters.astro';
import EventReel from '../components/EventReel.astro';
import Layout from '../layouts/Layout.astro';
import { getPublishedEvents } from '../lib/events';
import { isUpcoming, matchesDoor, parseDistrictParam, parseSubcategoryParam } from '../lib/filters';
import { categoryLabels, districtLabels } from '../lib/labels';
import { fetchPublishedVenues } from '../lib/sanity';
import { DOORS, LEGACY_CATEGORIES, doorHref, isCategory, listingKind, type Category } from '../../shared/taxonomy';

const categoryParam = Astro.url.searchParams.get('category');
const legacy = categoryParam ? (LEGACY_CATEGORIES as Record<string, Category>)[categoryParam] : undefined;
if (legacy) return Astro.redirect(doorHref(legacy));
if (categoryParam === 'events') return Astro.redirect('/browse');

const category = categoryParam && isCategory(categoryParam) ? categoryParam : null;
const requestedSub = parseSubcategoryParam(Astro.url.searchParams.get('sub'));
const sub = category && requestedSub && listingKind(category, requestedSub) ? requestedSub : null;
const district = parseDistrictParam(Astro.url.searchParams.get('district'));

const media: Record<Category, { image: string; place: string }> = {
  events: { image: '/media/hero-concert.jpg', place: 'Κύπρος' },
  panigyria: { image: '/media/village.jpg', place: 'Όμοδος' },
  music: { image: '/media/jazz.jpg', place: 'Λευκωσία' },
  food: { image: '/media/food.jpg', place: 'Λεμεσός' },
  culture: { image: '/media/theatre.jpg', place: 'Λευκωσία' },
  family: { image: '/media/kids.jpg', place: 'Λεμεσός' },
  outings: { image: '/media/trail.jpg', place: 'Τρόοδος' },
};

const categorySlides = DOORS.map((door) => ({
  name: door.label,
  place: media[door.id].place,
  year: '2026',
  image: media[door.id].image,
  href: doorHref(door.id),
}));

const feed = category ? await getPublishedEvents() : null;
let venues: Awaited<ReturnType<typeof fetchPublishedVenues>> = [];
if (category) {
  try {
    venues = await fetchPublishedVenues();
  } catch (error) {
    console.error(error);
  }
}
const eventSlides = (feed?.events ?? [])
  .filter((event) => category && matchesDoor(event, category, sub, district) && isUpcoming(event))
  .map((event) => ({
    name: event.title,
    place: event.locationName || districtLabels[event.district],
    year: new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Nicosia', year: 'numeric' }).format(new Date(event.startDate)),
    image: event.imageUrl,
    href: `/events/${event.slug}`,
  }));
const venueSlides = venues
  .filter((venue) => category && matchesDoor(venue, category, sub, district))
  .map((venue) => ({
    name: venue.title,
    place: venue.locationName || districtLabels[venue.district],
    year: 'Χώρος',
    image: venue.imageUrl,
    href: `/venues/${venue.slug}`,
  }));

const slides = category ? [...eventSlides, ...venueSlides] : categorySlides;
const description = category
  ? `${categoryLabels[category]} στην Κύπρο.`
  : 'Κατηγορίες στην Κύπρο: εκδηλώσεις, πανηγύρια, μουσική, γεύσεις, πολιτισμός, οικογένεια και εξορμήσεις.';
---

<Layout title={category ? categoryLabels[category] : 'Κατηγορίες'} description={description} bare locked>
  {category && <DoorFilters door={category} sub={sub} district={district} />}
  <EventReel
    slides={slides}
    showBack={Boolean(category)}
    emptyText="Δεν υπάρχει κάτι σε αυτό το φίλτρο."
    emptyHref={category ? doorHref(category) : '/categories'}
    emptyLabel={category ? 'Όλα' : 'Όλες οι κατηγορίες'}
  />
</Layout>
