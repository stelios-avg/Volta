---
export const prerender = false;

import CalendarPlus from '@lucide/astro/icons/calendar-plus';
import Download from '@lucide/astro/icons/download';
import MapPin from '@lucide/astro/icons/map-pin';
import Ticket from '@lucide/astro/icons/ticket';
import WhatsAppIcon from '../../components/WhatsAppIcon.astro';
import Layout from '../../layouts/Layout.astro';
import { isUpcoming } from '../../lib/filters';
import { extractPriceAmount, formatWhen } from '../../lib/format';
import { categoryLabels, districtLabels } from '../../lib/labels';
import { getEventBySlug } from '../../lib/events';
import { googleCalendarUrl, mapsUrl, whatsappUrl } from '../../lib/share';
import { plainText, renderDescription } from '../../lib/text';

const slug = Astro.params.slug;
const { event } = slug ? await getEventBySlug(slug) : { event: null };

if (!event) {
  Astro.response.status = 404;
}

const pageUrl = event ? new URL(`/events/${event.slug}`, Astro.url.origin).href : Astro.url.href;
const summary = event ? plainText(event.description).replace(/\s+/g, ' ').slice(0, 180) : 'Η εκδήλωση δεν βρέθηκε.';
const image = event
  ? event.imageUrl.startsWith('http')
    ? event.imageUrl
    : new URL(event.imageUrl, Astro.url.origin).href
  : undefined;
const upcoming = event ? isUpcoming(event) : false;
const html = event ? renderDescription(event.description) : '';
const price = event ? extractPriceAmount(event.priceText) : 0;

const jsonLd = event
  ? {
      '@context': 'https://schema.org',
      '@type': 'Event',
      name: event.title,
      description: plainText(event.description),
      startDate: event.startDate,
      endDate: event.endDate,
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      eventStatus: upcoming ? 'https://schema.org/EventScheduled' : 'https://schema.org/EventScheduled',
      image: image ? [image] : undefined,
      location: {
        '@type': 'Place',
        name: event.locationName,
        address: `${event.district}, Cyprus`,
      },
      offers: {
        '@type': 'Offer',
        price,
        priceCurrency: 'EUR',
        url: event.ticketUrl || pageUrl,
        availability: 'https://schema.org/InStock',
      },
    }
  : undefined;

if (event) {
  Astro.response.headers.set('Cache-Control', 'public, max-age=60, stale-while-revalidate=300');
}
---

<Layout
  title={event ? event.title : 'Η εκδήλωση δεν βρέθηκε'}
  description={summary}
  image={image}
  canonical={pageUrl}
  ogType="article"
  jsonLd={jsonLd}
>
  {
    event ? (
      <article class="mx-auto max-w-3xl px-4 pb-36 pt-5 sm:px-6 md:pb-16 md:pt-8">
        <a href="/browse" class="text-sm font-semibold text-sea-deep">← Όλες οι εκδηλώσεις</a>
        <div class="mt-4 overflow-hidden rounded-[28px] bg-sand">
          <img src={event.imageUrl} alt={event.imageAlt} width="1400" height="900" class="aspect-[16/10] w-full object-cover" />
        </div>
        <div class="mt-5 flex flex-wrap gap-2">
          <span class="rounded-full bg-paper px-3 py-1 text-xs font-semibold text-sea-deep ring-1 ring-line">{districtLabels[event.district]}</span>
          <span class="rounded-full bg-paper px-3 py-1 text-xs font-medium text-muted ring-1 ring-line">{categoryLabels[event.category]}</span>
          {event.isFeatured && (
            <span class="rounded-full bg-ink px-3 py-1 text-xs font-semibold text-sun">Sponsored · Προτεινόμενο</span>
          )}
          {!upcoming && <span class="rounded-full bg-line px-3 py-1 text-xs font-semibold">Ολοκληρώθηκε</span>}
        </div>
        <h1 class="mt-4 text-4xl font-semibold tracking-tight text-balance">{event.title}</h1>
        <dl class="mt-6 grid gap-3 sm:grid-cols-3">
          <div class="rounded-2xl bg-paper p-4 ring-1 ring-line">
            <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-muted">Πότε</dt>
            <dd class="mt-1 font-medium">{formatWhen(event.startDate, event.endDate)}</dd>
          </div>
          <div class="rounded-2xl bg-paper p-4 ring-1 ring-line">
            <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-muted">Πού</dt>
            <dd class="mt-1 font-medium">{event.locationName}</dd>
          </div>
          <div class="rounded-2xl bg-paper p-4 ring-1 ring-line">
            <dt class="text-xs font-semibold uppercase tracking-[0.14em] text-muted">Είσοδος</dt>
            <dd class="mt-1 font-medium">{event.priceText}</dd>
          </div>
        </dl>
        <div class="prose-event mt-8" set:html={html} />

        <div class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-paper/95 backdrop-blur-md md:static md:z-0 md:mt-8 md:rounded-[28px] md:border">
          <div class="mx-auto flex max-w-3xl flex-col gap-2 px-3 py-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] md:flex-row md:items-center">
            {event.ticketUrl && (
              <a
                href={event.ticketUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex flex-1 items-center justify-center gap-2 rounded-2xl bg-coral px-4 py-3 text-sm font-semibold text-white"
              >
                <Ticket size={16} aria-hidden="true" />
                Εισιτήρια
              </a>
            )}
            <div class="grid flex-1 grid-cols-4 gap-2">
              <a href={mapsUrl(event)} target="_blank" rel="noopener noreferrer" title="Άνοιγμα στο Google Maps" class="flex flex-col items-center gap-1 rounded-2xl bg-sand px-1 py-2 text-center text-[10px] font-semibold leading-tight sm:text-xs">
                <MapPin size={16} aria-hidden="true" />
                Χάρτης
              </a>
              <a href={googleCalendarUrl(event, pageUrl)} target="_blank" rel="noopener noreferrer" title="Προσθήκη στο Google Calendar" class="flex flex-col items-center gap-1 rounded-2xl bg-sand px-1 py-2 text-center text-[10px] font-semibold leading-tight sm:text-xs">
                <CalendarPlus size={16} aria-hidden="true" />
                Ημερολόγιο
              </a>
              <a href={`/api/calendar/${event.slug}`} title="Λήψη αρχείου .ics" class="flex flex-col items-center gap-1 rounded-2xl bg-sand px-1 py-2 text-center text-[10px] font-semibold leading-tight sm:text-xs">
                <Download size={16} aria-hidden="true" />
                .ics
              </a>
              <a href={whatsappUrl(event, pageUrl)} target="_blank" rel="noopener noreferrer" title="Κοινοποίηση στο WhatsApp" class="flex flex-col items-center gap-1 rounded-2xl bg-sand px-1 py-2 text-center text-[10px] font-semibold leading-tight sm:text-xs">
                <WhatsAppIcon size={16} />
                WhatsApp
              </a>
            </div>
          </div>
        </div>
      </article>
    ) : (
      <div class="mx-auto max-w-lg px-4 py-24 text-center">
        <h1 class="text-3xl font-semibold">Η εκδήλωση δεν βρέθηκε</h1>
        <p class="mt-3 text-muted">Μπορεί να αποσύρθηκε ή να μην έχει δημοσιευτεί ακόμα.</p>
        <a href="/browse" class="mt-6 inline-flex rounded-full bg-ink px-4 py-2.5 text-sm font-semibold text-white">Πίσω στις εκδηλώσεις</a>
      </div>
    )
  }
</Layout>
