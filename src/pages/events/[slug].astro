---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { isUpcoming } from '../../lib/filters';
import { extractPriceAmount, formatWhen } from '../../lib/format';
import { categoryLabels, districtLabels } from '../../lib/labels';
import { getEventBySlug } from '../../lib/events';
import { googleCalendarUrl, mapsUrl, whatsappUrl } from '../../lib/share';
import { plainText, renderDescription } from '../../lib/text';

const slug = Astro.params.slug;
const { event } = slug ? await getEventBySlug(slug) : { event: null };

if (!event) {
  Astro.response.status = 404;
}

const pageUrl = event ? new URL(`/events/${event.slug}`, Astro.url.origin).href : Astro.url.href;
const summary = event ? plainText(event.description).replace(/\s+/g, ' ').slice(0, 180) : 'Η εκδήλωση δεν βρέθηκε.';
const image = event
  ? event.imageUrl.startsWith('http')
    ? event.imageUrl
    : new URL(event.imageUrl, Astro.url.origin).href
  : undefined;
const upcoming = event ? isUpcoming(event) : false;
const html = event ? renderDescription(event.description) : '';
const fullImage = event ? event.imageUrl.replace(/\?.*$/, '') + (event.imageUrl.includes('cdn.sanity.io') ? '?auto=format&q=85' : '') : '';
const price = event ? extractPriceAmount(event.priceText) : 0;

const jsonLd = event
  ? {
      '@context': 'https://schema.org',
      '@type': 'Event',
      name: event.title,
      description: plainText(event.description),
      startDate: event.startDate,
      endDate: event.endDate,
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      eventStatus: upcoming ? 'https://schema.org/EventScheduled' : 'https://schema.org/EventScheduled',
      image: image ? [image] : undefined,
      location: {
        '@type': 'Place',
        name: event.locationName,
        address: `${event.district}, Cyprus`,
      },
      offers: {
        '@type': 'Offer',
        price,
        priceCurrency: 'EUR',
        url: event.ticketUrl || pageUrl,
        availability: 'https://schema.org/InStock',
      },
    }
  : undefined;

if (event) {
  Astro.response.headers.set('Cache-Control', 'public, max-age=60, stale-while-revalidate=300');
}
---

<Layout
  title={event ? event.title : 'Η εκδήλωση δεν βρέθηκε'}
  description={summary}
  image={image}
  canonical={pageUrl}
  ogType="article"
  jsonLd={jsonLd}
  bare
>
  <a href="/browse" class="event-back">
    <span aria-hidden="true">←</span>
    Εκδηλώσεις
  </a>
  {
    event ? (
      <article class="event-page">
        <div class="event-frame">
          <p class="event-kicker">
            {categoryLabels[event.category]}
            <span aria-hidden="true">·</span>
            {districtLabels[event.district]}
            {event.isFeatured && <span>Προτεινόμενο</span>}
            {!upcoming && <span>Ολοκληρώθηκε</span>}
          </p>
          <h1>{event.title}</h1>
          <button type="button" class="event-photo" data-photo aria-label="Μεγέθυνση φωτογραφίας">
            <img src={event.imageUrl} alt={event.imageAlt} width="1400" height="900" />
          </button>
          <dialog class="event-lightbox" data-lightbox>
            <button type="button" class="event-lightbox-close" data-close>Κλείσιμο</button>
            <img src={fullImage} alt="" />
          </dialog>
          <dl>
            <div>
              <dt>Πότε</dt>
              <dd>{formatWhen(event.startDate, event.endDate)}</dd>
            </div>
            <div>
              <dt>Πού</dt>
              <dd>{event.locationName}</dd>
            </div>
            <div>
              <dt>Είσοδος</dt>
              <dd>{event.priceText}</dd>
            </div>
          </dl>
          <div class="event-copy" set:html={html} />
          <div class="event-actions">
            {event.ticketUrl && (
              <a class="is-solid" href={event.ticketUrl} target="_blank" rel="noopener noreferrer">
                Εισιτήρια
              </a>
            )}
            <a href={mapsUrl(event)} target="_blank" rel="noopener noreferrer">Χάρτης</a>
            <a href={googleCalendarUrl(event, pageUrl)} target="_blank" rel="noopener noreferrer">Ημερολόγιο</a>
            <a href={`/api/calendar/${event.slug}`}>Αρχείο .ics</a>
            <a href={whatsappUrl(event, pageUrl)} target="_blank" rel="noopener noreferrer">WhatsApp</a>
          </div>
        </div>
      </article>
    ) : (
      <article class="event-page">
        <div class="event-frame">
          <h1>Δεν βρέθηκε</h1>
          <p class="event-missing">Μπορεί να αποσύρθηκε ή να μην έχει δημοσιευτεί ακόμα.</p>
          <div class="event-actions">
            <a class="is-solid" href="/browse">Πίσω στις εκδηλώσεις</a>
          </div>
        </div>
      </article>
    )
  }
</Layout>

<style>
  .event-back {
    position: fixed;
    z-index: 30;
    top: 18px;
    left: 18px;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid #111;
    border-radius: 999px;
    background: #e7e0d1;
    color: #111;
    padding: 0.45rem 0.85rem;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .event-page {
    min-height: 100dvh;
    background: #e7e0d1;
    color: #16120c;
    padding: 92px 20px 72px;
  }

  .event-frame {
    max-width: 860px;
    margin: 0 auto;
    border: 1px solid #111;
    border-radius: 36px;
    padding: 42px 40px 32px;
  }

  .event-kicker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0;
    color: #6f6d6a;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .event-frame h1 {
    margin: 14px 0 0;
    font-family: Archivo, Inter, sans-serif;
    font-size: clamp(40px, 7vw, 76px);
    font-weight: 900;
    letter-spacing: -0.045em;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .event-photo {
    display: block;
    width: 100%;
    margin: 28px 0 0;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .event-frame img {
    display: block;
    width: 100%;
    max-height: 640px;
    border: 1px solid #111;
    border-radius: 22px;
    object-fit: contain;
    background: #f4efe6;
  }

  .event-lightbox {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 64px 24px 24px;
    border: 0;
    background: rgba(22, 18, 12, 0.94);
  }

  :global(body:has(.event-lightbox[open]) .event-back) {
    visibility: hidden;
  }

  .event-lightbox::backdrop {
    background: transparent;
  }

  .event-lightbox img {
    width: 100%;
    height: 100%;
    max-height: none;
    margin: 0;
    border: 0;
    border-radius: 0;
    object-fit: contain;
    background: transparent;
    cursor: default;
  }

  .event-lightbox-close {
    position: absolute;
    top: 18px;
    right: 18px;
    border: 1px solid #f3ede1;
    border-radius: 999px;
    background: transparent;
    color: #f3ede1;
    padding: 0.45rem 0.85rem;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .event-frame dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin: 28px 0 0;
  }

  .event-frame dt {
    color: #6f6d6a;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .event-frame dd {
    margin: 6px 0 0;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.4;
  }

  .event-copy {
    margin-top: 28px;
    max-width: 40rem;
  }

  .event-copy :global(p) {
    margin: 0.9rem 0 0;
    color: #3c3832;
    font-size: 16px;
    line-height: 1.6;
  }

  .event-copy :global(p:first-child) {
    margin-top: 0;
  }

  .event-copy :global(a) {
    color: #16120c;
  }

  .event-copy :global(table) {
    width: 100%;
    margin-top: 1rem;
    border-collapse: collapse;
    font-size: 14px;
  }

  .event-copy :global(td),
  .event-copy :global(th) {
    border-bottom: 1px solid #16120c;
    padding: 0.55rem 0.35rem;
    text-align: left;
    vertical-align: top;
  }

  .event-missing {
    margin: 16px 0 0;
    color: #3c3832;
    font-size: 16px;
  }

  .event-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 32px;
  }

  .event-actions a {
    display: inline-flex;
    align-items: center;
    border: 1px solid #111;
    border-radius: 999px;
    background: transparent;
    color: #16120c;
    padding: 0.75rem 1rem;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .event-actions a.is-solid {
    background: #16120c;
    color: #f3ede1;
  }

  @media (max-width: 720px) {
    .event-page {
      padding: 104px 12px 120px;
    }

    .event-frame {
      border-radius: 22px;
      padding: 28px 18px 22px;
    }

    .event-frame dl {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .event-frame img {
      max-height: 420px;
      border-radius: 16px;
    }

    .event-lightbox {
      padding: 72px 12px 12px;
    }
  }
</style>

<script>
  const opener = document.querySelector('[data-photo]');
  const dialog = document.querySelector('[data-lightbox]');
  if (opener instanceof HTMLButtonElement && dialog instanceof HTMLDialogElement) {
    opener.addEventListener('click', () => dialog.showModal());
    dialog.addEventListener('click', (event) => {
      const target = event.target;
      if (target === dialog || (target instanceof Element && target.closest('[data-close]'))) dialog.close();
    });
  }
</script>
