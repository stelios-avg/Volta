---
export const prerender = false;

import SubmitForm from '../components/SubmitForm.astro';
import Layout from '../layouts/Layout.astro';
import { stripeClient } from '../lib/stripe';

const status = Astro.url.searchParams.get('status');
const preview = Astro.url.searchParams.get('preview') === '1';
let paymentState: 'verified' | 'unverified' | null = null;

if (status === 'boosted') {
  const sessionId = Astro.url.searchParams.get('session_id');
  const stripe = stripeClient();
  if (!stripe || !sessionId) paymentState = 'unverified';
  else {
    try {
      const session = await stripe.checkout.sessions.retrieve(sessionId);
      paymentState = session.payment_status === 'paid' || session.status === 'complete' ? 'verified' : 'unverified';
    } catch {
      paymentState = 'unverified';
    }
  }
}

Astro.response.headers.set('Cache-Control', 'private, no-store');
const showForm = !status || status === 'cancelled';
---

<Layout
  title="Καταχώρηση εκδήλωσης"
  description="Στείλε την εκδήλωσή σου δωρεάν για έλεγχο."
  robots={status ? 'noindex, nofollow' : undefined}
>
  <div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 md:py-12">
    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-sea">Για διοργανωτές</p>
    <h1 class="mt-2 text-4xl font-semibold tracking-tight">Καταχώρησε την εκδήλωσή σου</h1>
    <p class="mt-3 max-w-2xl text-muted">
      Η καταχώρηση είναι δωρεάν και ελέγχεται μέσα σε 48 ώρες. Δημοσιεύεται μετά την έγκριση.
    </p>

    {
      status === 'free' && (
        <div class="mt-8 rounded-[28px] bg-paper p-6 ring-1 ring-line">
          <h2 class="text-2xl font-semibold">Η εκδήλωσή σου θα ελεγχθεί εντός 48 ωρών</h2>
          <p class="mt-3 text-muted">Θα δημοσιευτεί μόλις την εγκρίνει η ομάδα. Δεν χρειάζεται να στείλεις κάτι άλλο.</p>
          {preview && <p class="mt-3 text-sm text-sea-deep">Δοκιμαστική λειτουργία: δεν έχει συνδεθεί ακόμα Sanity, οπότε η καταχώρηση δεν αποθηκεύτηκε.</p>}
          <a href="/browse" class="mt-6 inline-flex rounded-full bg-ink px-4 py-2.5 text-sm font-semibold text-white">Πίσω στις εκδηλώσεις</a>
        </div>
      )
    }

    {
      status === 'boosted' && (
        <div class="mt-8 rounded-[28px] bg-paper p-6 ring-1 ring-line">
          {paymentState === 'verified' ? (
            <>
              <h2 class="text-2xl font-semibold">Η πληρωμή ολοκληρώθηκε</h2>
              <p class="mt-3 text-muted">Η εκδήλωση σημάνθηκε ως προβεβλημένη και δημοσιεύτηκε. Το σήμα «Προτεινόμενο» μένει ενεργό για 30 ημέρες.</p>
            </>
          ) : (
            <>
              <h2 class="text-2xl font-semibold">Δεν επιβεβαιώθηκε η πληρωμή</h2>
              <p class="mt-3 text-muted">Αν χρεώθηκες, η δημοσίευση θα ολοκληρωθεί μόλις το Stripe επιβεβαιώσει τη συνεδρία. Αλλιώς η καταχώρηση μένει σε αναμονή.</p>
            </>
          )}
          <a href="/browse" class="mt-6 inline-flex rounded-full bg-ink px-4 py-2.5 text-sm font-semibold text-white">Πίσω στις εκδηλώσεις</a>
        </div>
      )
    }

    {
      status === 'payment-unavailable' && (
        <div class="mt-8 rounded-[28px] bg-paper p-6 ring-1 ring-line">
          <h2 class="text-2xl font-semibold">Η καταχώρηση έμεινε σε αναμονή</h2>
          <p class="mt-3 text-muted">
            {preview
              ? 'Δοκιμαστική λειτουργία: χωρίς κλειδιά Sanity και Stripe δεν αποθηκεύεται εκδήλωση και δεν ανοίγει πληρωμή.'
              : 'Η εκδήλωση αποθηκεύτηκε για έλεγχο, αλλά το Stripe δεν είναι ρυθμισμένο, οπότε η προβεβλημένη θέση δεν ενεργοποιήθηκε.'}
          </p>
          <a href="/browse" class="mt-6 inline-flex rounded-full bg-ink px-4 py-2.5 text-sm font-semibold text-white">Πίσω στις εκδηλώσεις</a>
        </div>
      )
    }

    {showForm && <SubmitForm />}
  </div>
</Layout>
