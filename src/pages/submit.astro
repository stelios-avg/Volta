---
export const prerender = false;

import '@fontsource/archivo/latin-900.css';
import SubmitForm from '../components/SubmitForm.astro';
import Layout from '../layouts/Layout.astro';
import { stripeClient } from '../lib/stripe';

const status = Astro.url.searchParams.get('status');
const preview = Astro.url.searchParams.get('preview') === '1';
let paymentState: 'verified' | 'unverified' | null = null;

if (status === 'boosted') {
  const sessionId = Astro.url.searchParams.get('session_id');
  const stripe = stripeClient();
  if (!stripe || !sessionId) paymentState = 'unverified';
  else {
    try {
      const session = await stripe.checkout.sessions.retrieve(sessionId);
      paymentState = session.payment_status === 'paid' || session.status === 'complete' ? 'verified' : 'unverified';
    } catch {
      paymentState = 'unverified';
    }
  }
}

Astro.response.headers.set('Cache-Control', 'private, no-store');
const showForm = !status || status === 'cancelled';
---

<Layout
  title="Νέα καταχώριση"
  description="Στείλε δωρεάν μια εκδήλωση ή έναν χώρο φιλοξενίας για έλεγχο."
  robots={status ? 'noindex, nofollow' : undefined}
  bare
>
  <div class="submit-page">
    <div class="submit-bar">
      <a href="/?ready=1" class="submit-back">
        <span aria-hidden="true">←</span>
        Αρχική
      </a>
    </div>

    <section class="submit-frame">
      <a class="submit-brand" href="/?ready=1" aria-label="Volta">
        <img src="/favicon.png" alt="" width="72" height="72" />
        <span>Volta</span>
      </a>
      <div class="submit-head">
        <h1>Νέα καταχώριση</h1>
        <p class="submit-lead">Διάλεξε κατηγορία και υποκατηγορία. Η ημερομηνία ζητείται στις εκδηλώσεις. Στους χώρους μένει κενή. Έλεγχος μέσα σε 48 ώρες και δημοσίευση μετά την έγκριση.</p>
      </div>

      {
        status === 'free' && (
          <div class="submit-status">
            <h2>Η καταχώρηση περιμένει έγκριση</h2>
            <p>
              {preview
                ? 'Δοκιμαστική λειτουργία: δεν έχει συνδεθεί ακόμα το Sanity, οπότε η καταχώρηση δεν αποθηκεύτηκε.'
                : 'Την λάβαμε. Θα ελεγχθεί και θα δημοσιευτεί μετά την έγκριση. Δεν χρειάζεται να κάνεις κάτι άλλο.'}
            </p>
            <a href="/browse">Πίσω στις εκδηλώσεις</a>
          </div>
        )
      }

      {
        status === 'boosted' && (
          <div class="submit-status">
            {paymentState === 'verified' ? (
              <>
                <h2>Η πληρωμή ολοκληρώθηκε</h2>
                <p>Η εκδήλωση σημάνθηκε ως προβεβλημένη και δημοσιεύτηκε.</p>
              </>
            ) : (
              <>
                <h2>Δεν επιβεβαιώθηκε η πληρωμή</h2>
                <p>Αν χρεώθηκες, η δημοσίευση θα ολοκληρωθεί μόλις επιβεβαιωθεί η συνεδρία. Αλλιώς η καταχώρηση μένει σε αναμονή.</p>
              </>
            )}
            <a href="/browse">Πίσω στις εκδηλώσεις</a>
          </div>
        )
      }

      {
        status === 'payment-unavailable' && (
          <div class="submit-status">
            <h2>Η καταχώρηση έμεινε σε αναμονή</h2>
            <p>
              {preview
                ? 'Δοκιμαστική λειτουργία: χωρίς σύνδεση βάσης η καταχώρηση δεν αποθηκεύτηκε.'
                : 'Η εκδήλωση αποθηκεύτηκε για έλεγχο.'}
            </p>
            <a href="/browse">Πίσω στις εκδηλώσεις</a>
          </div>
        )
      }

      {showForm && <SubmitForm />}
    </section>
  </div>
</Layout>

<style is:global>
  .submit-page {
    min-height: 100dvh;
    background: #e7e0d1;
    color: #16120c;
    padding: 22px 20px 108px;
  }

  .submit-bar,
  .submit-frame {
    max-width: 760px;
    margin-right: auto;
    margin-left: auto;
  }

  .submit-bar {
    margin-bottom: 18px;
  }

  .submit-back {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid #16120c;
    border-radius: 999px;
    background: transparent;
    color: #16120c;
    padding: 0.45rem 0.85rem;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .submit-frame {
    border: 1px solid #16120c;
    border-radius: 36px;
    background: #f4efe6;
    padding: 36px 40px 32px;
    box-shadow: 0 22px 50px rgba(22, 18, 12, 0.05);
  }

  .submit-brand {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    width: fit-content;
    margin: 0 auto;
    color: inherit;
    text-decoration: none;
  }

  .submit-brand img {
    width: 64px;
    height: 64px;
    object-fit: contain;
  }

  .submit-brand span {
    font-family: Archivo, Inter, sans-serif;
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .submit-head {
    margin-top: 22px;
    text-align: center;
  }

  .submit-frame h1 {
    margin: 0;
    font-family: Archivo, Inter, sans-serif;
    font-size: clamp(40px, 6vw, 68px);
    font-weight: 900;
    letter-spacing: -0.045em;
    line-height: 0.9;
    text-transform: uppercase;
  }

  .submit-lead,
  .submit-note,
  .submit-status p {
    max-width: 34rem;
    margin: 14px auto 0;
    color: #3c3832;
    font-size: 15px;
    line-height: 1.55;
  }

  .submit-form {
    display: grid;
    gap: 1.6rem;
    margin-top: 2.1rem;
  }

  .submit-block {
    display: grid;
    gap: 0.95rem;
    margin: 0;
    border: 0;
    padding: 0;
  }

  .submit-block legend {
    display: block;
    width: 100%;
    margin-bottom: 0.15rem;
    padding: 0 0 0.55rem;
    border-bottom: 1px solid rgba(22, 18, 12, 0.14);
    color: #6f6d6a;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .submit-grid {
    display: grid;
    gap: 0.95rem;
  }

  .submit-page .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .submit-page .field span {
    color: #16120c;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .submit-page .field small,
  .submit-note {
    color: #6f6d6a;
    font-size: 13px;
  }

  .submit-page .field input,
  .submit-page .field select,
  .submit-page .field textarea {
    width: 100%;
    border: 1px solid rgba(22, 18, 12, 0.18);
    border-radius: 14px;
    background: #fbf7f0;
    padding: 0.8rem 0.9rem;
    color: #16120c;
    font-size: 16px;
  }

  .submit-page .field textarea {
    min-height: 7.5rem;
    border-radius: 18px;
    resize: vertical;
  }

  .submit-page .field select {
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, #16120c 50%), linear-gradient(135deg, #16120c 50%, transparent 50%);
    background-position: calc(100% - 18px) calc(50% - 2px), calc(100% - 12px) calc(50% - 2px);
    background-size: 6px 6px, 6px 6px;
    background-repeat: no-repeat;
    padding-right: 2.1rem;
  }

  .submit-page .field input:focus,
  .submit-page .field select:focus,
  .submit-page .field textarea:focus {
    outline: none;
    border-color: #16120c;
    background-color: #fffdf8;
  }

  .submit-note {
    margin-top: 0;
    text-align: center;
  }

  .submit-error {
    margin: 0;
    color: #9a3412;
    font-size: 14px;
    text-align: center;
  }

  .submit-send,
  .submit-status a {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    justify-content: center;
    justify-self: center;
    border: 1px solid #16120c;
    border-radius: 999px;
    background: #16120c;
    color: #f3ede1;
    padding: 0.9rem 1.4rem;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .submit-status {
    margin-top: 1.75rem;
    text-align: center;
  }

  .submit-status h2 {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .submit-status a {
    margin-top: 1.25rem;
  }

  @media (min-width: 721px) {
    .submit-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 720px) {
    .submit-page {
      padding: 16px 12px 96px;
    }

    .submit-frame {
      border-radius: 24px;
      padding: 28px 16px 22px;
    }

    .submit-brand img {
      width: 52px;
      height: 52px;
    }

    .submit-frame h1 {
      font-size: clamp(32px, 9vw, 42px);
    }

    .submit-send {
      width: 100%;
    }
  }
</style>
