---
import Search from '@lucide/astro/icons/search';
import SlidersHorizontal from '@lucide/astro/icons/sliders-horizontal';
import X from '@lucide/astro/icons/x';
import FilterGroups from './FilterGroups.astro';
import type { EventFilters } from '../lib/filters';

interface Props {
  filters: EventFilters;
}

const { filters } = Astro.props;
const activeCount = [filters.timeframe, filters.district !== 'all', filters.category, filters.q.trim()].filter(Boolean).length;
---

<div class="sticky top-16 z-20 hidden border-b border-line/80 bg-sand/90 py-3 backdrop-blur-md md:block">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <FilterGroups filters={filters} />
  </div>
</div>

<div id="mobile-filter-row" class="mx-auto mt-4 max-w-6xl px-4 sm:px-6 md:hidden">
  <FilterGroups filters={filters} />
</div>

<div id="filter-fab" class="pointer-events-none fixed inset-x-0 bottom-4 z-40 flex justify-center px-4 md:hidden" hidden>
  <button
    id="open-filters"
    type="button"
    class="pointer-events-auto inline-flex items-center gap-2 rounded-full bg-ink px-4 py-3 text-sm font-semibold text-white shadow-[0_12px_30px_rgba(23,35,43,0.28)]"
  >
    <SlidersHorizontal size={16} aria-hidden="true" />
    Φίλτρα
    <span id="filter-count" class="grid h-5 min-w-5 place-items-center rounded-full bg-sun px-1.5 text-xs text-ink" hidden={activeCount === 0}>
      {activeCount || ''}
    </span>
  </button>
</div>

<div id="filter-sheet" class="fixed inset-0 z-50 md:hidden" hidden>
  <button type="button" class="absolute inset-0 bg-ink/45" data-close-sheet aria-label="Κλείσιμο φίλτρων"></button>
  <div
    class="absolute inset-x-0 bottom-0 max-h-[86vh] overflow-auto rounded-t-[28px] bg-paper px-4 pb-[max(1rem,env(safe-area-inset-bottom))] pt-3 shadow-2xl"
    role="dialog"
    aria-modal="true"
    aria-labelledby="filter-sheet-title"
  >
    <div class="mx-auto mb-3 h-1.5 w-12 rounded-full bg-line"></div>
    <div class="mb-4 flex items-center justify-between gap-3">
      <h2 id="filter-sheet-title" class="text-lg font-semibold">Φίλτρα</h2>
      <button id="close-filters" type="button" class="grid h-10 w-10 place-items-center rounded-full bg-sand" data-close-sheet aria-label="Κλείσιμο">
        <X size={18} aria-hidden="true" />
      </button>
    </div>
    <form data-search-form action="/browse" class="mb-4">
      <label class="field">
        <span>Αναζήτηση</span>
        <span class="relative block">
          <Search size={16} class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-muted" aria-hidden="true" />
          <input
            data-search-input
            name="q"
            value={filters.q}
            placeholder="Χωριό, συναυλία, κάστρο…"
            class="!pl-9"
            enterkeyhint="search"
          />
        </span>
      </label>
    </form>
    <FilterGroups filters={filters} />
    <button type="button" class="mt-5 w-full rounded-full bg-coral py-3 text-sm font-semibold text-white" data-close-sheet>
      Δες αποτελέσματα
    </button>
  </div>
</div>
