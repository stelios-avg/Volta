---
import { DISTRICTS, DOORS, SUBCATEGORIES } from '../../shared/taxonomy';
import { districtLabels } from '../lib/labels';
---

<form id="submit-form" class="submit-form" enctype="multipart/form-data">
  <div class="absolute -left-[9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
    <label>
      Company
      <input name="company" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <label class="field">
    <span data-label-event="Τίτλος" data-label-venue="Όνομα χώρου">Τίτλος</span>
    <input name="title" required minlength="3" maxlength="140" placeholder="Πανηγύρι στο Όμοδος" />
  </label>

  <label class="field">
    <span>Περιγραφή</span>
    <textarea name="description" maxlength="4000" placeholder="Προαιρετικά. Ακόμα και μία λέξη."></textarea>
  </label>

  <div class="grid gap-4 sm:grid-cols-2" data-for="event">
    <label class="field">
      <span>Έναρξη</span>
      <input name="startDate" type="datetime-local" required />
    </label>
    <label class="field">
      <span>Λήξη (προαιρετικά)</span>
      <input name="endDate" type="datetime-local" />
    </label>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <label class="field">
      <span>Επαρχία</span>
      <select name="district" required>
        <option value="">Επίλεξε επαρχία</option>
        {DISTRICTS.map((district) => <option value={district}>{districtLabels[district]}</option>)}
      </select>
    </label>
    <label class="field">
      <span>Κατηγορία</span>
      <select name="category" required>
        {DOORS.map((door) => <option value={door.id}>{door.label}</option>)}
      </select>
    </label>
    <label class="field">
      <span>Υποκατηγορία</span>
      <select name="subcategory" required>
        {SUBCATEGORIES.map((item) => (
          <option value={item.id} data-door={item.door} data-listing={item.listing}>
            {item.label}
          </option>
        ))}
      </select>
    </label>
  </div>

  <label class="field">
    <span data-label-event="Χώρος ή χωριό" data-label-venue="Διεύθυνση ή περιοχή">Χώρος ή χωριό</span>
    <input name="locationName" required minlength="2" maxlength="160" placeholder="Κάστρο Πάφου" />
  </label>

  <div class="grid gap-4 sm:grid-cols-2">
    <label class="field">
      <span>Σύνδεσμος Google Maps</span>
      <input name="googleMapsUrl" type="url" inputmode="url" placeholder="https://" />
    </label>
    <label class="field" data-for="event">
      <span>Είσοδος</span>
      <input name="priceText" maxlength="40" placeholder="Δωρεάν, €15, Είσοδος ελεύθερη" />
    </label>
    <label class="field" data-for="venue">
      <span>Ιστότοπος</span>
      <input name="websiteUrl" type="url" inputmode="url" placeholder="https://" />
    </label>
  </div>

  <label class="field" data-for="event">
    <span>Σύνδεσμος εισιτηρίων</span>
    <input name="ticketUrl" type="url" inputmode="url" placeholder="https://" />
  </label>

  <label class="field">
    <span>Εικόνα (JPG, PNG ή WebP, έως 4MB)</span>
    <input name="image" type="file" accept="image/jpeg,image/png,image/webp" />
  </label>

  <label class="field">
    <span>Email ή τηλέφωνο επικοινωνίας</span>
    <input name="organizerContact" required autocomplete="email" placeholder="name@example.com" />
    <small class="text-xs font-medium text-muted">Μένει εσωτερικά στην ομάδα και δεν δημοσιεύεται.</small>
  </label>

  <input type="hidden" name="tier" value="free" />
  <p class="submit-note">Η καταχώρηση είναι δωρεάν. Ελέγχεται μέσα σε 48 ώρες και δημοσιεύεται μετά την έγκριση.</p>

  <p id="form-error" hidden class="submit-error"></p>

  <button id="submit-button" type="submit" class="submit-send">Υποβολή για έλεγχο</button>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('#submit-form');
  const errorBox = document.querySelector<HTMLElement>('#form-error');
  const button = document.querySelector<HTMLButtonElement>('#submit-button');

  const doorSelect = form?.querySelector<HTMLSelectElement>('select[name="category"]');
  const subSelect = form?.querySelector<HTMLSelectElement>('select[name="subcategory"]');

  const selectedListing = () => {
    const option = subSelect?.selectedOptions[0];
    return option?.dataset.listing === 'venue' ? 'venue' : 'event';
  };

  const applyListing = () => {
    if (!form || !doorSelect || !subSelect) return;
    const door = doorSelect.value;
    let first = '';
    Array.from(subSelect.options).forEach((option) => {
      const show = option.dataset.door === door;
      option.hidden = !show;
      option.disabled = !show;
      if (show && !first) first = option.value;
    });
    if (subSelect.selectedOptions[0]?.disabled && first) subSelect.value = first;
    const kind = selectedListing();
    form.querySelectorAll<HTMLElement>('[data-for]').forEach((node) => {
      const show = node.dataset.for === kind;
      node.hidden = !show;
      node.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea').forEach((input) => {
        input.disabled = !show;
      });
    });
    form.querySelectorAll<HTMLElement>('[data-label-event]').forEach((node) => {
      const next = kind === 'venue' ? node.dataset.labelVenue : node.dataset.labelEvent;
      if (next) node.textContent = next;
    });
    const title = form.querySelector<HTMLInputElement>('input[name="title"]');
    if (title) title.placeholder = kind === 'venue' ? 'Πολιτιστικό Κέντρο Όμοδος' : 'Πανηγύρι στο Όμοδος';
    const description = form.querySelector<HTMLTextAreaElement>('textarea[name="description"]');
    if (description) {
      description.placeholder = kind === 'venue' ? 'Προαιρετικά. Τι γίνεται στον χώρο.' : 'Προαιρετικά. Ακόμα και μία λέξη.';
    }
    const location = form.querySelector<HTMLInputElement>('input[name="locationName"]');
    if (location) location.placeholder = kind === 'venue' ? 'Όμοδος' : 'Κάστρο Πάφου';
  };

  doorSelect?.addEventListener('change', applyListing);
  subSelect?.addEventListener('change', applyListing);
  applyListing();

  const showError = (message: string) => {
    if (!errorBox) return;
    errorBox.hidden = !message;
    errorBox.textContent = message;
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !button) return;
    if (!form.reportValidity()) return;
    showError('');
    button.disabled = true;
    const original = button.textContent;
    button.textContent = 'Αποστολή…';
    const kind = selectedListing();
    try {
      const response = await fetch(kind === 'venue' ? '/api/submit-venue' : '/api/submit-event', {
        method: 'POST',
        body: new FormData(form),
      });
      const data = await response.json();
      if (!response.ok || !data.ok) {
        showError(Array.isArray(data.errors) ? data.errors.join(' ') : 'Η υποβολή δεν ολοκληρώθηκε.');
        button.disabled = false;
        button.textContent = original;
        return;
      }
      const preview = data.preview ? '1' : '0';
      const emailed = data.emailed ? '1' : '0';
      window.location.href = `/submit?status=free&preview=${preview}&emailed=${emailed}`;
    } catch {
      showError('Κάτι πήγε στραβά στο δίκτυο. Δοκίμασε ξανά.');
      button.disabled = false;
      button.textContent = original;
    }
  });
</script>
