---
import { DISTRICTS, DOORS, SUBCATEGORIES } from '../../shared/taxonomy';
import { districtLabels } from '../lib/labels';
---

<form id="submit-form" class="submit-form" enctype="multipart/form-data">
  <div class="absolute -left-[9999px] h-0 w-0 overflow-hidden" aria-hidden="true">
    <label>
      Company
      <input name="company" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <div class="submit-steps" role="tablist" aria-label="Βήματα καταχώρισης">
    <button type="button" data-step-jump="what" aria-selected="true">Τι</button>
    <button type="button" data-step-jump="when" data-for="event">Πότε</button>
    <button type="button" data-step-jump="where">Πού</button>
    <button type="button" data-step-jump="extra">Λεπτομέρειες</button>
  </div>

  <fieldset class="submit-block is-on" data-step-id="what">
    <legend>Τι</legend>
    <label class="field">
      <span data-label-event="Τίτλος" data-label-venue="Όνομα χώρου">Τίτλος</span>
      <input name="title" required minlength="3" maxlength="140" placeholder="Πανηγύρι στο Όμοδος" />
    </label>
    <label class="field">
      <span>Περιγραφή</span>
      <textarea name="description" maxlength="4000" placeholder="Προαιρετικά."></textarea>
    </label>
    <div class="submit-grid">
      <label class="field">
        <span>Κατηγορία</span>
        <select name="category" required>
          {DOORS.map((door) => <option value={door.id}>{door.label}</option>)}
        </select>
      </label>
      <label class="field">
        <span>Υποκατηγορία</span>
        <select name="subcategory" required>
          {SUBCATEGORIES.map((item) => (
            <option value={item.id} data-door={item.door} data-listing={item.listing}>
              {item.label}
            </option>
          ))}
        </select>
      </label>
    </div>
  </fieldset>

  <fieldset class="submit-block" data-step-id="when" data-for="event">
    <legend>Πότε</legend>
    <div class="submit-grid">
      <label class="field">
        <span>Ημέρα έναρξης</span>
        <input name="startDay" type="date" required />
      </label>
      <label class="field">
        <span>Ώρα έναρξης</span>
        <input name="startTime" type="time" required />
      </label>
    </div>
    <div class="submit-grid">
      <label class="field">
        <span>Ημέρα λήξης</span>
        <input name="endDay" type="date" />
      </label>
      <label class="field">
        <span>Ώρα λήξης</span>
        <input name="endTime" type="time" />
      </label>
    </div>
  </fieldset>

  <fieldset class="submit-block" data-step-id="where">
    <legend>Πού</legend>
    <div class="submit-grid">
      <label class="field">
        <span>Επαρχία</span>
        <select name="district" required>
          <option value="">Επίλεξε επαρχία</option>
          {DISTRICTS.map((district) => <option value={district}>{districtLabels[district]}</option>)}
        </select>
      </label>
      <label class="field">
        <span data-label-event="Χώρος ή χωριό" data-label-venue="Διεύθυνση ή περιοχή">Χώρος ή χωριό</span>
        <input name="locationName" required minlength="2" maxlength="160" placeholder="Κάστρο Πάφου" />
      </label>
    </div>
    <label class="field">
      <span>Σύνδεσμος Google Maps</span>
      <input name="googleMapsUrl" type="url" inputmode="url" placeholder="https://" />
    </label>
  </fieldset>

  <fieldset class="submit-block" data-step-id="extra">
    <legend>Λεπτομέρειες</legend>
    <div class="submit-grid">
      <label class="field" data-for="event">
        <span>Είσοδος</span>
        <input name="priceText" maxlength="40" placeholder="Δωρεάν, €15, Είσοδος ελεύθερη" />
      </label>
      <label class="field" data-for="event">
        <span>Σύνδεσμος εισιτηρίων</span>
        <input name="ticketUrl" type="url" inputmode="url" placeholder="https://" />
      </label>
      <label class="field" data-for="venue">
        <span>Ιστότοπος</span>
        <input name="websiteUrl" type="url" inputmode="url" placeholder="https://" />
      </label>
    </div>
    <label class="field">
      <span>Εικόνα, έως 4MB</span>
      <span class="file-pick">
        <input class="file-input" name="image" type="file" accept="image/jpeg,image/png,image/webp" />
        <span class="file-button">Διάλεξε φωτογραφία</span>
        <span class="file-name">JPG, PNG ή WebP</span>
      </span>
    </label>
    <label class="field">
      <span>Email ή τηλέφωνο επικοινωνίας</span>
      <input name="organizerContact" required autocomplete="email" placeholder="name@example.com" />
      <small>Μένει εσωτερικά στην ομάδα και δεν δημοσιεύεται.</small>
    </label>
  </fieldset>

  <input type="hidden" name="tier" value="free" />
  <p class="submit-note">Η καταχώρηση είναι δωρεάν. Ελέγχεται μέσα σε 48 ώρες και δημοσιεύεται μετά την έγκριση.</p>

  <p id="form-error" hidden class="submit-error"></p>

  <div class="submit-move">
    <button id="submit-prev" type="button" class="submit-prev" hidden>Πίσω</button>
    <button id="submit-next" type="button" class="submit-next">Συνέχεια</button>
    <button id="submit-button" type="submit" class="submit-send" hidden>Υποβολή για έλεγχο</button>
  </div>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('#submit-form');
  const errorBox = document.querySelector<HTMLElement>('#form-error');
  const button = document.querySelector<HTMLButtonElement>('#submit-button');
  const prev = document.querySelector<HTMLButtonElement>('#submit-prev');
  const next = document.querySelector<HTMLButtonElement>('#submit-next');

  const doorSelect = form?.querySelector<HTMLSelectElement>('select[name="category"]');
  const subSelect = form?.querySelector<HTMLSelectElement>('select[name="subcategory"]');
  const subOptions = subSelect ? Array.from(subSelect.options).map((option) => option.cloneNode(true) as HTMLOptionElement) : [];
  let step = 0;

  const selectedListing = () => {
    const option = subSelect?.selectedOptions[0];
    return option?.dataset.listing === 'venue' ? 'venue' : 'event';
  };

  const panels = () =>
    form ? [...form.querySelectorAll<HTMLFieldSetElement>('fieldset.submit-block')].filter((panel) => !panel.hidden) : [];

  const fieldsIn = (panel: HTMLElement) =>
    [...panel.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea')].filter(
      (field) => field.willValidate,
    );

  const panelIsValid = (panel: HTMLElement) => {
    const invalid = fieldsIn(panel).find((field) => !field.checkValidity());
    invalid?.reportValidity();
    return !invalid;
  };

  const paint = () => {
    if (!form || !prev || !next || !button) return;
    const list = panels();
    if (step >= list.length) step = Math.max(0, list.length - 1);
    list.forEach((panel, index) => panel.classList.toggle('is-on', index === step));
    form.querySelectorAll<HTMLButtonElement>('[data-step-jump]').forEach((jump) => {
      const current = list[step]?.dataset.stepId === jump.dataset.stepJump;
      jump.setAttribute('aria-selected', current ? 'true' : 'false');
    });
    prev.hidden = step === 0;
    next.hidden = step >= list.length - 1;
    button.hidden = step < list.length - 1;
  };

  const revealInvalid = () => {
    const list = panels();
    const index = list.findIndex((panel) => !panelIsValid(panel));
    if (index === -1) return true;
    step = index;
    paint();
    panelIsValid(list[index]);
    return false;
  };

  const applyListing = () => {
    if (!form || !doorSelect || !subSelect) return;
    const door = doorSelect.value;
    const current = subSelect.value;
    subSelect.replaceChildren();
    subOptions.forEach((option) => {
      if (option.dataset.door === door) subSelect.append(option.cloneNode(true));
    });
    const match = [...subSelect.options].some((option) => option.value === current);
    if (match) subSelect.value = current;
    const kind = selectedListing();
    form.querySelectorAll<HTMLElement>('[data-for]').forEach((node) => {
      const show = node.dataset.for === kind;
      node.hidden = !show;
      node.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea').forEach((input) => {
        input.disabled = !show;
      });
    });
    form.querySelectorAll<HTMLElement>('[data-label-event]').forEach((node) => {
      const label = kind === 'venue' ? node.dataset.labelVenue : node.dataset.labelEvent;
      if (label) node.textContent = label;
    });
    const title = form.querySelector<HTMLInputElement>('input[name="title"]');
    if (title) title.placeholder = kind === 'venue' ? 'Πολιτιστικό Κέντρο Όμοδος' : 'Πανηγύρι στο Όμοδος';
    const description = form.querySelector<HTMLTextAreaElement>('textarea[name="description"]');
    if (description) description.placeholder = kind === 'venue' ? 'Προαιρετικά. Τι γίνεται στον χώρο.' : 'Προαιρετικά.';
    const location = form.querySelector<HTMLInputElement>('input[name="locationName"]');
    if (location) location.placeholder = kind === 'venue' ? 'Όμοδος' : 'Κάστρο Πάφου';
    paint();
  };

  doorSelect?.addEventListener('change', applyListing);
  subSelect?.addEventListener('change', applyListing);
  applyListing();

  prev?.addEventListener('click', () => {
    step = Math.max(0, step - 1);
    paint();
  });

  next?.addEventListener('click', () => {
    const panel = panels()[step];
    if (panel && !panelIsValid(panel)) return;
    step += 1;
    paint();
  });

  form?.querySelectorAll<HTMLButtonElement>('[data-step-jump]').forEach((jump) => {
    jump.addEventListener('click', () => {
      const list = panels();
      const target = list.findIndex((panel) => panel.dataset.stepId === jump.dataset.stepJump);
      if (target < 0) return;
      const current = panels()[step];
      if (target > step && current && !panelIsValid(current)) return;
      step = target;
      paint();
    });
  });

  form?.querySelector<HTMLInputElement>('.file-input')?.addEventListener('change', (event) => {
    const input = event.currentTarget;
    const name = form.querySelector('.file-name');
    if (!(input instanceof HTMLInputElement) || !name) return;
    name.textContent = input.files?.[0]?.name || 'JPG, PNG ή WebP';
  });

  const showError = (message: string) => {
    if (!errorBox) return;
    errorBox.hidden = !message;
    errorBox.textContent = message;
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !button) return;
    if (!revealInvalid()) return;
    showError('');
    button.disabled = true;
    const original = button.textContent;
    button.textContent = 'Αποστολή…';
    const kind = selectedListing();
    try {
      const response = await fetch(kind === 'venue' ? '/api/submit-venue' : '/api/submit-event', {
        method: 'POST',
        body: new FormData(form),
      });
      const data = await response.json();
      if (!response.ok || !data.ok) {
        showError(Array.isArray(data.errors) ? data.errors.join(' ') : 'Η υποβολή δεν ολοκληρώθηκε.');
        button.disabled = false;
        button.textContent = original;
        return;
      }
      const preview = data.preview ? '1' : '0';
      const emailed = data.emailed ? '1' : '0';
      window.location.href = `/submit?status=free&preview=${preview}&emailed=${emailed}`;
    } catch {
      showError('Κάτι πήγε στραβά στο δίκτυο. Δοκίμασε ξανά.');
      button.disabled = false;
      button.textContent = original;
    }
  });
</script>
