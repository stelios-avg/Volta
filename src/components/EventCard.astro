---
import MapPin from '@lucide/astro/icons/map-pin';
import { formatDayBadge, formatTime } from '../lib/format';
import { categoryLabels, districtLabels, searchText } from '../lib/labels';
import type { EventRecord } from '../lib/types';

interface Props {
  event: EventRecord;
  featured?: boolean;
  hidden?: boolean;
  priority?: boolean;
}

const { event, featured = false, hidden = false, priority = false } = Astro.props;
const badge = formatDayBadge(event.startDate);
const href = `/events/${event.slug}`;
---

<article
  data-event-card
  data-section={featured ? 'featured' : 'feed'}
  data-start={event.startDate}
  data-end={event.endDate ?? ''}
  data-district={event.district}
  data-category={event.category}
  data-search={searchText(event)}
  hidden={hidden}
  class:list={[
    'min-w-0 overflow-hidden rounded-[28px] bg-paper shadow-[0_16px_40px_rgba(23,35,43,0.06)]',
    featured ? 'featured-ring w-[82%] shrink-0 snap-start sm:w-[340px]' : 'border border-line',
  ]}
>
  <a href={href} class="group block h-full">
    <div class="relative aspect-[16/10] overflow-hidden bg-sand">
      <img
        src={event.imageUrl}
        alt={event.imageAlt}
        width="1400"
        height="900"
        loading={priority ? 'eager' : 'lazy'}
        decoding="async"
        class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
      />
      <div class="absolute left-3 top-3 min-w-12 rounded-2xl bg-paper/95 px-2.5 py-1.5 text-center shadow-sm">
        <span class="block text-[10px] font-semibold uppercase tracking-[0.14em] text-sea">{badge.month}</span>
        <span class="block text-lg font-semibold leading-none">{badge.day}</span>
      </div>
      {
        featured && (
          <span class="absolute right-3 top-3 rounded-full bg-ink/90 px-2.5 py-1 text-[11px] font-semibold text-sun">
            Sponsored · Προτεινόμενο
          </span>
        )
      }
    </div>
    <div class="flex h-[calc(100%-1px)] flex-col p-4">
      <div class="flex flex-wrap gap-1.5">
        <span class="rounded-full bg-sand px-2.5 py-1 text-xs font-semibold text-sea-deep">{districtLabels[event.district]}</span>
        <span class="rounded-full bg-sand px-2.5 py-1 text-xs font-medium text-muted">{categoryLabels[event.category]}</span>
      </div>
      <h3 class="mt-3 text-lg font-semibold tracking-tight text-balance">{event.title}</h3>
      <p class="mt-2 flex items-start gap-1.5 text-sm text-muted">
        <MapPin size={16} class="mt-0.5 shrink-0" aria-hidden="true" />
        <span>{event.locationName}</span>
      </p>
      <div class="mt-4 flex items-center justify-between gap-3 text-sm">
        <time datetime={event.startDate} class="text-muted">{formatTime(event.startDate)}</time>
        <span class="font-semibold">{event.priceText}</span>
      </div>
    </div>
  </a>
</article>
