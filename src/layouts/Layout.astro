---
import '../styles/global.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  ogType?: string;
  robots?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  bare?: boolean;
  locked?: boolean;
}

const {
  title,
  description,
  image,
  canonical = Astro.url.href,
  ogType = 'website',
  robots,
  jsonLd,
  bare = false,
  locked = false,
} = Astro.props;

const fullTitle = title === 'Volta' ? title : `${title} · Volta`;
const json = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : '';
---

<!doctype html>
<html lang="el">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="theme-color" content="#e7e0d1" />
    <meta name="theme-color" content="#e7e0d1" media="(prefers-color-scheme: dark)" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="canonical" href={canonical} />
    <meta property="og:locale" content="el_CY" />
    <meta property="og:site_name" content="What's On Cyprus" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {image && <meta name="twitter:image" content={image} />}
    {json && <script type="application/ld+json" set:html={json} />}
    <script is:inline>
      try {
        if (sessionStorage.getItem('volta-enter') === '1') {
          sessionStorage.removeItem('volta-enter');
          document.documentElement.classList.add('is-entering');
        }
      } catch (error) {}
    </script>
  </head>
  <body class:list={['antialiased', locked ? 'reel-lock' : bare ? 'reel-page' : 'text-ink']}>
    <div class="page-curtain" aria-hidden="true">
      <img src="/favicon.png" alt="" width="64" height="64" />
    </div>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-white"
    >
      Μετάβαση στο περιεχόμενο
    </a>
    {!bare && <SiteHeader />}
    <main id="main">
      <slot />
    </main>
    {!bare && <SiteFooter />}
    <a class="studio-credit" href="https://www.pixel-studio.design/" target="_blank" rel="noopener noreferrer">
      powered by Pixel-Studio
    </a>
    <script>
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.querySelector('.page-curtain')?.addEventListener('animationend', (event) => {
        if (event.target !== event.currentTarget) return;
        if (event.animationName === 'curtain-out') document.documentElement.classList.remove('is-entering');
      });
      if (!reducedMotion) {
        window.addEventListener('pointerdown', (event) => {
          if (event.button !== 0) return;
          const mark = document.createElement('img');
          mark.src = '/cursor-tap.png';
          mark.alt = '';
          mark.className = 'logo-tap';
          mark.style.left = `${event.clientX}px`;
          mark.style.top = `${event.clientY}px`;
          document.body.appendChild(mark);
          mark.addEventListener('animationend', () => mark.remove());
        });

        document.addEventListener('click', (event) => {
          if (event.defaultPrevented || event.button !== 0) return;
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          const link = event.target instanceof Element ? event.target.closest('a') : null;
          if (!link || link.target === '_blank' || link.hasAttribute('download')) return;
          let url;
          try {
            url = new URL(link.href, location.href);
          } catch {
            return;
          }
          if (url.origin !== location.origin || url.pathname === location.pathname) return;
          event.preventDefault();
          const curtain = document.querySelector('.page-curtain');
          if (!curtain) {
            location.href = link.href;
            return;
          }
          try {
            sessionStorage.setItem('volta-enter', '1');
          } catch {
            location.href = link.href;
            return;
          }
          document.documentElement.classList.remove('is-entering');
          curtain.classList.remove('is-leaving');
          void curtain.offsetWidth;
          curtain.classList.add('is-leaving');
          let gone = false;
          const go = () => {
            if (gone) return;
            gone = true;
            location.href = link.href;
          };
          curtain.addEventListener('animationend', (end) => {
            if (end.target === curtain) go();
          });
          window.setTimeout(go, 480);
        });
      }
    </script>
  </body>
</html>
