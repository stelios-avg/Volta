# Public site origin used for Stripe return URLs and canonical links.
# On Vercel you can leave this empty and the request origin is used.
PUBLIC_SITE_URL=http://localhost:4321

# Sanity (https://www.sanity.io/manage)
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
# Write token: Editor permissions. Used by /api/submit-event and the Stripe webhook.
SANITY_API_TOKEN=
# Optional read token. Required only when the dataset is private.
SANITY_API_READ_TOKEN=

# Same project, read by the Sanity Studio (`npm run studio`).
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production

# Optional. Emails you when a submission is saved. The free Resend plan delivers only to your own address.
RESEND_API_KEY=
MODERATION_EMAIL=stelios0102@gmail.com

# Optional database for submissions. Without these, local reviews are stored in data/submissions.json.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Stripe (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
